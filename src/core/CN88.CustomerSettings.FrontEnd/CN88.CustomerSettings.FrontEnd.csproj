<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>netcoreapp2.1</TargetFramework>
        <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
        <TypeScriptToolsVersion>Latest</TypeScriptToolsVersion>
        <IsPackable>false</IsPackable>
        <SpaRoot>CN88\</SpaRoot>
        <DefaultItemExcludes>$(DefaultItemExcludes);$(SpaRoot)node_modules\**</DefaultItemExcludes>
    </PropertyGroup>
	
	<PropertyGroup>
    <!-- Exclude the project from analysis -->
    <SonarQubeExclude>true</SonarQubeExclude>
  </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.AspNetCore.Razor.Design" Version="2.1.2" PrivateAssets="All" />
        <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="2.1.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- Don't publish the SPA source files, but do show them in the project files list -->
        <Content Remove="$(SpaRoot)**" />
        <None Include="$(SpaRoot)**" Exclude="$(SpaRoot)node_modules\**" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="$(SpaRoot)Scripts\Typings\**" />
        <None Remove="$(SpaRoot)Publish\**" />
        <None Remove="$(SpaRoot)Temp\**" />
    </ItemGroup>

    <ItemGroup>
      <TypeScriptCompile Include="CN88\Scripts\Typings\angularjs\angular-animate.d.ts" />
      <TypeScriptCompile Include="CN88\Scripts\Typings\angularjs\angular-cookies.d.ts" />
      <TypeScriptCompile Include="CN88\Scripts\Typings\angularjs\angular-mocks.d.ts" />
      <TypeScriptCompile Include="CN88\Scripts\Typings\angularjs\angular-resource.d.ts" />
      <TypeScriptCompile Include="CN88\Scripts\Typings\angularjs\angular-route.d.ts" />
      <TypeScriptCompile Include="CN88\Scripts\Typings\angularjs\angular-sanitize.d.ts" />
      <TypeScriptCompile Include="CN88\Scripts\Typings\angularjs\angular.d.ts" />
      <TypeScriptCompile Include="CN88\Scripts\Typings\chalk\chalk.d.ts" />
      <TypeScriptCompile Include="CN88\Scripts\Typings\gulp-util\gulp-util.d.ts" />
      <TypeScriptCompile Include="CN88\Scripts\Typings\htmlparser2\htmlparser2.d.ts" />
      <TypeScriptCompile Include="CN88\Scripts\Typings\jquery\jquery.d.ts" />
      <TypeScriptCompile Include="CN88\Scripts\Typings\node\node.d.ts" />
      <TypeScriptCompile Include="CN88\Scripts\Typings\through2\through2.d.ts" />
      <TypeScriptCompile Include="CN88\Scripts\Typings\tsd.d.ts" />
      <TypeScriptCompile Include="CN88\Scripts\Typings\underscore\underscore.d.ts" />
      <TypeScriptCompile Include="CN88\Scripts\Typings\vinyl\vinyl.d.ts" />
    </ItemGroup>

    <Target Name="DebugEnsureNodeEnv" BeforeTargets="Build" Condition=" '$(Configuration)' == 'Debug' And !Exists('$(SpaRoot)node_modules') ">
        <!-- Ensure Node.js is installed -->
        <Exec Command="node --version" ContinueOnError="true">
            <Output TaskParameter="ExitCode" PropertyName="ErrorCode" />
        </Exec>
        <Error Condition="'$(ErrorCode)' != '0'" Text="Node.js is required to build and run this project. To continue, please install Node.js from https://nodejs.org/, and then restart your command prompt or IDE." />
        <Message Importance="high" Text="Restoring dependencies using 'npm'. This may take several minutes..." />
        <Exec WorkingDirectory="$(SpaRoot)" Command="npm install" />
    </Target>
</Project>